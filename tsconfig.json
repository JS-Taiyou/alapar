{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    },
    "types": ["vite/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "test/**/*"],
  "exclude": ["dist"]
}
