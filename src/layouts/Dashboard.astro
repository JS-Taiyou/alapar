---
import Base from "@/layouts/Base.astro";

/**
 * Shared dashboard chrome: Base layout + content column. The sidebar used to
 * be mounted here as its own island; /dashboard now hydrates a single
 * DashboardShell (sidebar + content, one React tree), while server-rendered
 * pages (history) mount the standalone SidebarIsland themselves.
 */
interface Props {
  title?: string;
}

const { title = "A la par - Dashboard" } = Astro.props;
---

<Base title={title}>
  <slot />
</Base>
