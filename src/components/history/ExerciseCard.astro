---
import { formatMoney } from "@/lib/format";
import { formatCalendarDate, t as translate, type Locale } from "@/lib/i18n";
import type { Exercise } from "@/lib/types";

interface Props {
  exercise: Exercise;
  monthName: string;
  personalTotal?: number;
  locale?: Locale;
}

const { exercise, monthName, personalTotal } = Astro.props;
const locale = Astro.props.locale ?? "es";
const t = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const totalDisplay =
  personalTotal !== undefined
    ? `${personalTotal >= 0 ? "+" : "-"}$${formatMoney(Math.abs(personalTotal))}`
    : `$${formatMoney(exercise.totalAmount)}`;
---

<a
  href={`/dashboard/history/${exercise.id}`}
  data-exercise-card
  class="w-full flex items-center justify-between p-4 bg-surface border border-white/10 rounded-custom hover:bg-white/5 hover:translate-x-1 transition-all group text-left"
>
  <div class="flex items-center gap-4">
    <div class="h-10 w-10 bg-white/10 rounded-custom flex items-center justify-center text-zinc-300 font-bold text-xs">
      {monthName}
    </div>
    <div>
      <p class="font-medium text-zinc-100 leading-tight">
        {t("history.cut_label")}{" "}
        {formatCalendarDate(exercise.endDate, locale, { month: "long", year: "numeric" })}
      </p>
      <p class="text-xs text-zinc-400">
        {exercise.transactionCount === 1
          ? t("history.expenses_one")
          : t("history.expenses_other", { n: exercise.transactionCount })}{" "}
        &bull; {t("history.total_label")} {totalDisplay} &bull;
        {formatCalendarDate(exercise.endDate, locale, {
          day: "numeric",
          month: "short",
          year: "numeric",
        })}
      </p>
    </div>
  </div>
  <svg
    class="h-5 w-5 text-zinc-500 group-hover:text-primary-light"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
  </svg>
</a>
