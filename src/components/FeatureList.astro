---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="space-y-2.5 text-left">
  {items.map((item) => (
    <li class="flex items-start gap-2.5 text-sm text-zinc-300">
      <svg
        class="w-4 h-4 mt-0.5 shrink-0 text-emerald-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M5 13l4 4L19 7"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
        ></path>
      </svg>
      <span>{item}</span>
    </li>
  ))}
</ul>
