---
import Base from "@/layouts/Base.astro";
import { resolveLocale, t } from "@/lib/i18n";
import { getCookie } from "@/lib/auth-cookies";

// Astro.locals may be unpopulated on error paths, so keep this page free of
// anything that needs it: the locale is read straight from the request.
const locale = resolveLocale(
  getCookie(Astro.request.headers.get("cookie") ?? "", "alapar-locale"),
  Astro.request.headers.get("accept-language"),
);
---

<Base title="A la par - 404">
  <main class="min-h-screen flex items-center justify-center p-6">
    <div class="bg-surface border border-border-custom rounded-custom p-8 w-full max-w-md z-10 text-center">
      <h1 class="text-4xl font-bold text-white mb-2">404</h1>
      <p class="text-zinc-400 text-sm mb-6">{t(locale, "not_found.heading")}</p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-primary hover:bg-primary-light text-white font-semibold rounded-custom transition-all"
      >
        {t(locale, "join.go_home")}
      </a>
    </div>
  </main>
</Base>
