---
import Base from "@/layouts/Base.astro";

// Astro.locals may be unpopulated on error paths, so keep this page
// dependency-free beyond the Base layout.
---

<Base title="A la par - 404">
  <main class="min-h-screen flex items-center justify-center p-6 bg-pattern">
    <div class="absolute inset-0 gradient-glow pointer-events-none"></div>
    <div class="bg-surface border border-border-custom rounded-custom p-8 w-full max-w-md z-10 text-center">
      <h1 class="text-4xl font-bold text-white mb-2">404</h1>
      <p class="text-zinc-400 text-sm mb-6">Not Found</p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-primary hover:bg-primary-light text-white font-semibold rounded-custom transition-all"
      >
        Ir al inicio
      </a>
    </div>
  </main>
</Base>
