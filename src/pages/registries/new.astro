---
import Base from "@/layouts/Base.astro";
import AuthCardLayout from "@/components/auth/AuthCardLayout.astro";
import { t as translate } from "@/lib/i18n";

const locale = Astro.locals.locale;
const t = (key: string) => translate(locale, key);
---

<Base title={t("registry.page_title")}>
  <AuthCardLayout>
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center p-3 bg-primary rounded-custom mb-4">
        <svg
          class="h-8 w-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 4v16m8-8H4"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white">{t("registry.new")}</h1>
      <p class="text-zinc-400 text-sm mt-2">
        {t("registry.new_desc")}
      </p>
    </div>
    <form action="/api/registries" method="POST" class="space-y-5">
      <div>
        <label
          class="block text-sm font-medium text-zinc-300 mb-1.5"
          for="name"
        >
          {t("registry.name_label")}
        </label>
        <input
          class="block w-full px-4 py-2.5 bg-background border border-border-field rounded-custom text-white focus:ring-primary-text focus:border-primary-text"
          id="name"
          name="name"
          type="text"
          placeholder={t("registry.name_placeholder")}
          required
        />
      </div>
      <button
        type="submit"
        class="w-full py-3 bg-primary hover:bg-primary-light text-white font-semibold rounded-custom transition-all shadow-lg active:scale-95"
      >
        {t("registry.create")}
      </button>
      <a
        href="/"
        class="block text-center text-sm text-zinc-400 hover:text-white transition-colors"
      >
        {t("common.cancel")}
      </a>
    </form>
  </AuthCardLayout>
</Base>
