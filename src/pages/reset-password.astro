---
import Base from "@/layouts/Base.astro";
import AuthCardLayout from "@/components/AuthCardLayout";
import ResetPassword from "@/islands/ResetPassword";
import { getSupabaseAnonKey, getSupabaseUrl } from "@/lib/supabase";
import { t as translate } from "@/lib/i18n";

const locale = Astro.locals.locale;
const t = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);
---

<Base title={`A la par - ${t("auth.reset_password")}`}>
  <AuthCardLayout pageTitle={`A la par - ${t("auth.reset_password")}`}>
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center p-3 bg-primary rounded-custom mb-4">
        <svg
          class="h-8 w-8 text-white"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
      </div>
      <h1 class="text-2xl font-bold text-white">
        {t("auth.reset_password")}
      </h1>
      <p class="text-zinc-400 text-sm mt-2">
        {t("auth.reset_password_subtitle")}
      </p>
    </div>

    <ResetPassword
      locale={locale}
      supabaseUrl={getSupabaseUrl()}
      supabaseAnonKey={getSupabaseAnonKey()}
      client:load
    />
  </AuthCardLayout>
</Base>
