---
import Base from "@/layouts/Base.astro";
import AuthCardLayout from "@/components/auth/AuthCardLayout.astro";
import JoinButton from "@/components/auth/JoinButton";
import { getInvitationByCode } from "@/lib/store";
import { t as translate } from "@/lib/i18n";

const code = Astro.params.code!;
const invitation = await getInvitationByCode(code);
const isLoggedIn = Astro.locals.user !== null;
const locale = Astro.locals.locale;
const t = (key: string, params?: Record<string, string | number>) =>
  translate(locale, key, params);

const inv = invitation;
const isExpired = inv?.expiresAt ? inv.expiresAt < new Date() : false;
const isRevoked = inv ? inv.revokedAt !== null : false;
const isMaxed = inv
  ? inv.maxUses !== null && inv.currentUses >= inv.maxUses
  : false;
const isInvalid = isExpired || isRevoked || isMaxed;

const pageTitle = inv
  ? t("join.page_title", { name: inv.registryName })
  : t("join.not_found_page_title");

// The code comes from the URL: escape it before it goes into the translated
// sentence as HTML.
const escapedCode = code.replace(
  /[&<>"']/g,
  (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
);
---

<Base title={pageTitle}>
  {!inv
    ? (
      <AuthCardLayout centered>
        <div class="inline-flex items-center justify-center p-3 bg-red-500/20 rounded-custom mb-4">
          <svg
            class="h-8 w-8 text-red-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">
          {t("join.not_found")}
        </h1>
        <p
          class="text-slate-400 mb-6"
          set:html={t("join.not_found_desc", {
            code: `<span class="font-mono text-white">${escapedCode}</span>`,
          })}
        />
        <a
          href="/"
          class="inline-block px-6 py-3 bg-primary hover:bg-primary-light text-white font-semibold rounded-custom transition-all"
        >
          {t("join.go_home")}
        </a>
      </AuthCardLayout>
    )
    : (
      <AuthCardLayout centered>
        <div class="inline-flex items-center justify-center p-3 bg-emerald-500/20 rounded-custom mb-4">
          <svg
            class="h-8 w-8 text-emerald-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            ></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">
          {t("join.join_registry", { name: inv.registryName })}
        </h1>
        <p class="text-slate-400 mb-6">
          {t("join.invited_desc")}
        </p>

        {isInvalid
          ? (
            <div class="text-sm text-red-400 bg-red-400/10 border border-red-400/20 rounded-custom px-4 py-3">
              {isExpired && t("join.expired")}
              {isRevoked && t("join.revoked")}
              {isMaxed && t("join.max_uses")}
            </div>
          )
          : isLoggedIn
          ? <JoinButton code={inv.code} locale={locale} client:load />
          : (
            <div class="space-y-3">
              <a
                href={`/login?redirect=/join/${inv.code}`}
                class="block w-full py-3 bg-primary hover:bg-primary-light text-white font-semibold rounded-custom transition-all shadow-lg"
              >
                {t("join.login_to_join")}
              </a>
              <a
                href={`/signup?redirect=/join/${inv.code}`}
                class="block w-full py-3 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold rounded-custom transition-all"
              >
                {t("join.create_account")}
              </a>
            </div>
          )}
      </AuthCardLayout>
    )}
</Base>
