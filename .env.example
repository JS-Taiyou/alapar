# Supabase
# DATABASE_URL is optional in local dev: when unset, src/lib/db.ts falls back
# to the docker-compose Postgres (docker compose up db) at
# postgresql://alapar:alapar@localhost:5432/alapar — no SSL, dev only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:you@example.com

# Auth cookie Secure flag. Defaults ON in production. Leave unset (or "false")
# for local HTTP development; set to "true" to force it on.
COOKIE_SECURE=false

# Polar billing (Pro tier). Sandbox for testing, production for live.
# OAT + webhook secret come from the Polar dashboard; the checkout link is the
# long-lived URL of the dashboard-configured Checkout Link.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=polar_oat_YOUR_TOKEN
POLAR_WEBHOOK_SECRET=polar_whsec_YOUR_SECRET
POLAR_CHECKOUT_LINK=https://sandbox.polar.sh/checkout/YOUR_LINK
# Optional: separate Checkout Link for the YEARLY product. Polar's documented
# checkout-link params don't include interval preselection, so yearly needs
# its own link when you offer both plans.
POLAR_CHECKOUT_LINK_YEARLY=
